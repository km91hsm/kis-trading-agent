# secrets/.env 로 복사해 채운다. 비어 있지 않은 환경변수가 이 파일을 덮어쓴다.
# 계좌 전용 키는 `KIS_<계좌접두사>_APP_KEY`·`_APP_SECRET`·`_CANO`·`_HTS_ID` 로 더 적을 수 있다.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
# 계좌번호 8자리 (config/accounts.yaml 의 cano 가 "00000000" 이면 여기서 읽는다)
KIS_PAPER_CANO=
KIS_REAL_CANO=
DART_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 그룹 채팅에서 쓰기 명령을 보낼 수 있는 사용자 id(쉼표). 비우면 1:1 채팅에서만
TELEGRAM_ALLOWED_USERS=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FRED_API_KEY=
ECOS_API_KEY=
# SEC EDGAR User-Agent(이름 + 연락 이메일)
EDGAR_USER_AGENT=
WEB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER=
# 체결통보 웹소켓 구독 키(HTS ID). 없으면 정기 체결 동기화만
KIS_HTS_ID=
